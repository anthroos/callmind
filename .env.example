# CallMind configuration — only GEMINI_API_KEY is required.
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Qdrant (docker compose sets QDRANT_HOST=qdrant automatically)
QDRANT_HOST=localhost
QDRANT_PORT=6333
CALLMIND_COLLECTION=callmind_memories

# Optional: Unkey API keys for /api/upload and /api/client/*/insights
UNKEY_API_ID=
UNKEY_ROOT_KEY=

# Server (local-only by default)
CALLMIND_HOST=127.0.0.1
CALLMIND_PORT=8000
CALLMIND_UPLOAD_DIR=./uploads
